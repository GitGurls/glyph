# Local Postgres + Redis via `docker compose up -d` in the project root (free, no cloud account)
DATABASE_URL="postgresql://glyph:glyph@localhost:5432/glyph"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Optional — leave blank to use the built-in rule-based prompt enhancer
GEMINI_API_KEY=""

# Stripe test mode (free to create — no card or business info required for test mode).
# Leave both blank to use the built-in mock checkout instead.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
